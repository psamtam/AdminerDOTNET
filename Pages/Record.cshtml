@page
@model RecordModel
@{ ViewData["Title"] = Model.Token is null ? "Insert record" : "Edit record"; }
@if (Model.Table is { } table && Model.Ready)
{
    <div class="eyebrow">@Model.DatabaseName · @table.Object.Label</div><h1>@ViewData["Title"]</h1>
    @if (table.Keys.Count == 0 && Model.Token is not null)
    {
        <p class="notice">This table has no primary key. Save or Delete affects one row matching the original values. Identical copies cannot be distinguished; only one copy will be changed.</p>
    }
    <p class="muted">Choose Value, NULL, or Default for each writable field. Empty Value stores empty text. Binary values use hexadecimal; dates use ISO format. Existing primary keys are read-only.</p>
    <form method="post" asp-route-db="@Model.Db" id="record-form">
        <input type="hidden" name="db" value="@Model.Db" />
        <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Token" />
        <div class="panel table-scroll"><table class="record-form"><thead><tr><th>Column</th><th>Mode</th><th>Value</th></tr></thead><tbody>
        @foreach (var c in table.Columns)
        {
            var writable = c.Writable && (Model.Token is null || c.KeyOrder == 0);
            <tr><td><strong>@c.Name</strong><small>@c.DisplayType @(c.Nullable ? "· nullable" : "· required")</small>@if(c.Default is not null) { <small>Default: @c.Default</small> }</td>
            @if (writable)
            {
                <td><select name="Modes[@c.Id]" class="field-mode" aria-label="@c.Name mode">
                <option value="value" selected="@(Model.Modes.GetValueOrDefault(c.Id) == "value")">Value</option>
                @if (c.Nullable) { <option value="null" selected="@(Model.Modes.GetValueOrDefault(c.Id) == "null")">NULL</option> }
                <option value="default" selected="@(Model.Modes.GetValueOrDefault(c.Id) == "default")">Default / omitted</option>
                </select></td>
                <td><textarea name="Values[@c.Id]" rows="2" spellcheck="false" aria-label="@c.Name value">@Model.Values.GetValueOrDefault(c.Id)</textarea></td>
            }
            else
            {
                <td class="muted">Read-only</td><td class="mono">@(Model.Snapshot?.Values[table.Columns.IndexOf(c)] ?? (c.Identity || c.Computed || c.Generated || c.IsVersion ? "Generated by SQL Server" : "Unsupported form type; use SQL"))</td>
            }
            </tr>
        }
        </tbody></table></div>
        <div class="toolbar"><button class="primary" asp-page-handler="Save" asp-route-db="@Model.Db">@(Model.Token is null ? "Insert record" : "Save changes")</button><a asp-page="/Browse" asp-route-db="@Model.Db" asp-route-id="@Model.Id">Back to table</a>
        @if (Model.Token is not null) { <button asp-page-handler="Reload" asp-route-db="@Model.Db" formnovalidate>Reload current record</button><button class="danger push-right" asp-page-handler="Delete" asp-route-db="@Model.Db" data-confirm="Delete this record? This cannot be undone." formnovalidate>Delete record</button> }
        </div>
    </form>
}
